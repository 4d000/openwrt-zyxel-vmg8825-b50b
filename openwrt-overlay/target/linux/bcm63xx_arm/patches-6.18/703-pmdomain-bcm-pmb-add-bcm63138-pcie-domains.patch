--- a/drivers/pmdomain/bcm/bcm-pmb.c
+++ b/drivers/pmdomain/bcm/bcm-pmb.c
@@ -239,6 +239,24 @@ static int bcm_pmb_power_on(struct gener
 	case BCM_PMB_PCIE0:
 	case BCM_PMB_PCIE1:
 	case BCM_PMB_PCIE2:
+		if (of_device_is_compatible(pmb->dev->of_node, "brcm,bcm63138-pmb")) {
+			void __iomem *perf = ioremap(0xfffe8000, 0x200);
+			if (perf) {
+				/* Ungate Ethernet, PCIe, USB, WLAN clocks */
+				writel(readl(perf + 0x04) | 0x800a2420, perf + 0x04);
+				/* Bit 0: PCIe0, Bit 1: PCIe1 soft reset */
+				writel(readl(perf + 0x180) | 0x3, perf + 0x180);
+				iounmap(perf);
+			}
+		}
 		return bcm_pmb_power_on_zone(pmb, data->bus, data->device, 0);
 	case BCM_PMB_HOST_USB:
+		if (of_device_is_compatible(pmb->dev->of_node, "brcm,bcm63138-pmb")) {
+			void __iomem *perf = ioremap(0xfffe8000, 0x200);
+			if (perf) {
+				writel(readl(perf + 0x04) | 0x800a2420, perf + 0x04);
+				iounmap(perf);
+			}
+		}
 		return bcm_pmb_power_on_device(pmb, data->bus, data->device);
@@ -330,6 +348,8 @@ static int bcm_pmb_probe(struct platform
 		pd->genpd.power_on = bcm_pmb_power_on;
 		pd->genpd.power_off = bcm_pmb_power_off;
+		if (of_device_is_compatible(dev->of_node, "brcm,bcm63138-pmb"))
+			pd->genpd.flags |= GENPD_FLAG_ALWAYS_ON;
 
 		pm_genpd_init(&pd->genpd, NULL, true);
 		pmb->genpd_onecell_data.domains[e->id] = &pd->genpd;
@@ -348,6 +368,9 @@ static const struct bcm_pmb_pd_data bcm_
 
 static const struct bcm_pmb_pd_data bcm_pmb_bcm63138_data[] = {
 	{ .name = "sata", .id = BCM_PMB_SATA, .bus = 0, .device = 3, },
+	{ .name = "pcie0", .id = BCM_PMB_PCIE0, .bus = 0, .device = 15, },
+	{ .name = "pcie1", .id = BCM_PMB_PCIE1, .bus = 0, .device = 16, },
+	{ .name = "usb", .id = BCM_PMB_HOST_USB, .bus = 1, .device = 17, },
 	{ },
 };
 
