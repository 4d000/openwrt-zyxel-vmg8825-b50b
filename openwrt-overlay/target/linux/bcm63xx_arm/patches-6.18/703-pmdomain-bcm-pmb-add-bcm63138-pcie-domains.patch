--- a/drivers/pmdomain/bcm/bcm-pmb.c	2026-10-30 13:06:41.000000000 +0100
+++ b/drivers/pmdomain/bcm/bcm-pmb.c	2026-11-18 13:50:21.712556387 +0100
@@ -240,6 +240,16 @@
 	case BCM_PMB_PCIE0:
 	case BCM_PMB_PCIE1:
 	case BCM_PMB_PCIE2:
+		if (of_device_is_compatible(pmb->dev->of_node, "brcm,bcm63138-pmb")) {
+			void __iomem *perf = ioremap(0xfffe8000, 0x200);
+			if (perf) {
+				/* Bit 17: PCIE_CLK_EN, Bit 5: WLAN_OCP_CLK_EN */
+				writel(readl(perf + 0x04) | 0x00020020, perf + 0x04);
+				/* Bit 0: PCIe0, Bit 1: PCIe1 soft reset */
+				writel(readl(perf + 0x180) | 0x3, perf + 0x180);
+				iounmap(perf);
+			}
+		}
 		return bcm_pmb_power_on_zone(pmb, data->bus, data->device, 0);
 	case BCM_PMB_HOST_USB:
 		return bcm_pmb_power_on_device(pmb, data->bus, data->device);
@@ -343,6 +353,9 @@
 
