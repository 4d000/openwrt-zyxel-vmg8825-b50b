+static int brcm_pcie_post_setup_bcm63138(struct brcm_pcie *pcie)
+{
+	void __iomem *base = pcie->base;
+	u32 tmp;
+
+	/*
+	 * BCM63138 uses UBUS instead of SCB. Configure MISC_CTRL for UBUS
+	 * 128B max burst, burst alignment, and inbound write combining.
+	 */
+	tmp = readl(base + PCIE_MISC_MISC_CTRL);
+	tmp &= ~(PCIE_MISC_MISC_CTRL_SCB0_SIZE_MASK |
+		 PCIE_MISC_MISC_CTRL_SCB_ACCESS_EN_MASK |
+		 PCIE_MISC_MISC_CTRL_MAX_BURST_SIZE_MASK);
+	tmp |= PCIE_MISC_MISC_CTRL_BCM63138_MAX_BURST_128B |
+	       PCIE_MISC_MISC_CTRL_BCM63138_BURST_ALIGN |
+	       PCIE_MISC_MISC_CTRL_BCM63138_IN_WR_COMBINE;
+	writel(tmp, base + PCIE_MISC_MISC_CTRL);
+
+	/*
+	 * Move the inbound DDR window from STB's BAR2 to BCM63138's BAR1
+	 * and enable UBUS BAR1 remap access so endpoint DMA can reach DDR.
+	 */
+	writel(readl(base + brcm_bar_reg_offset(2)), base + brcm_bar_reg_offset(1));
+	writel(readl(base + brcm_bar_reg_offset(2) + 4), base + brcm_bar_reg_offset(1) + 4);
+	writel(0, base + brcm_bar_reg_offset(2));
+	writel(0, base + brcm_bar_reg_offset(2) + 4);
+	writel(PCIE_MISC_UBUS_BAR1_CONFIG_REMAP_ACCESS_EN_MASK,
+	       base + brcm_ubus_reg_offset(1));
+
+	/* Unmask all PCIe L1 interrupts to CPU GIC */
+	writel(PCIE_CPU_INTR1_MASK_CLR_ALL, base + PCIE_CPU_INTR1_MASK_CLR);
+	return 0;
+}
