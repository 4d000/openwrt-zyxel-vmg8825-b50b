#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
zyxel,vmg8825-b50b)
	ucidef_set_led_netdev "wan" "WAN" "green:wan" "wan"
	ucidef_set_led_netdev "wan_online" "Internet" "green:wan-online" "wan" "link tx rx"
	ucidef_set_led_netdev "lan1" "LAN1" "green:lan1" "lan1"
	ucidef_set_led_netdev "lan2" "LAN2" "green:lan2" "lan2"
	ucidef_set_led_netdev "lan3" "LAN3" "green:lan3" "lan3"
	ucidef_set_led_netdev "lan4" "LAN4" "green:lan4" "lan4"
	ucidef_set_led_netdev "lan_link" "LAN Link" "green:lan-aggregate-link" "br-lan" "link"
	ucidef_set_led_netdev "lan_act" "LAN Activity" "green:lan-aggregate-act" "br-lan" "link tx rx"
	ucidef_set_led_netdev "wlan2g" "WLAN 2.4G" "green:wlan-2g" "phy1-ap0" "link tx rx"
	ucidef_set_led_netdev "wlan5g" "WLAN 5G" "green:wlan-5g" "phy0-ap0" "link tx rx"
	;;
esac

board_config_flush

exit 0
