. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh

board_config_update
board=$(board_name)

case "$board" in
zyxel,vmg8825-b50b)
	ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
	mac=$(mtd_get_mac_binary cferom 0x106a0)
	if [ -n "$mac" ]; then
		ucidef_set_interface_macaddr "lan" "$mac"
		ucidef_set_interface_macaddr "wan" "$(macaddr_add "$mac" 3)"
	fi
	;;
*)
	ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
	;;
esac

board_config_flush

exit 0
