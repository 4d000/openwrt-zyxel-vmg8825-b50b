#!/bin/sh

[ "$ACTION" = "add" ] || [ "$ACTION" = "move" ] || exit 0

case "$INTERFACE" in
eth0)
	[ -w /sys/class/net/eth0/queues/rx-0/rps_cpus ] && echo 1 > /sys/class/net/eth0/queues/rx-0/rps_cpus
	ETH_IRQ=$(awk -F: '/eth0/{gsub(/ /,"",$1); print $1; exit}' /proc/interrupts)
	[ -n "$ETH_IRQ" ] && [ -w "/proc/irq/$ETH_IRQ/smp_affinity" ] && echo 2 > "/proc/irq/$ETH_IRQ/smp_affinity"
	;;
phy*-ap*|wlan*)
	[ -w "/sys/class/net/$INTERFACE/queues/rx-0/rps_cpus" ] && echo 3 > "/sys/class/net/$INTERFACE/queues/rx-0/rps_cpus"
	(sleep 5; iw dev "$INTERFACE" set txpower fixed 2000 >/dev/null 2>&1; [ -w "/sys/class/net/$INTERFACE/queues/rx-0/rps_cpus" ] && echo 3 > "/sys/class/net/$INTERFACE/queues/rx-0/rps_cpus"; [ -w /sys/class/net/eth0/queues/rx-0/rps_cpus ] && echo 1 > /sys/class/net/eth0/queues/rx-0/rps_cpus; fw4 reload >/dev/null 2>&1) &
	;;
esac

exit 0
